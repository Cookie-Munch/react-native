{
  "name": "@cookiemunch/react-native",
  "version": "0.1.1",
  "description": "Cookie Munch React Native SDK — consent client, hook, banner",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/RNConsentBanner.tsx",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "expo-secure-store": "*",
    "react-native-keychain": "*",
    "@react-native-async-storage/async-storage": "*"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    },
    "react-native-keychain": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cookie-Munch/react-native.git"
  },
  "homepage": "https://cookiemunch.net/docs",
  "bugs": {
    "url": "https://github.com/Cookie-Munch/react-native/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@cookiemunch/geo": "file:./bundled/geo",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "react": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "cookiemunch": {
    "bundled": [
      "@cookiemunch/geo"
    ]
  }
